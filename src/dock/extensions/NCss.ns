// NCss.ns: NCX's screenshot extension, the Newton's side (PORTING.md 5.2).
// newtc compiles it into NCss.nsof (the ncx_extensions target, see
// src/dock/extensions/README.md); the desktop installs it with
// kDRegProtocolExtension ('pext', command 'NCss').
//
// The Cocoa NCX's 'snap' sent the whole screen in one event (76800 bytes on
// a MessagePad 2x00): too much for a real Newton's serial link, and with
// the bits a lot for its NewtonScript heap (NTK's Toolkit catches
// evt.ex.outofmem when it takes a screenshot, and then takes it in parts).
// This one takes the screen a few rows at a time, as the Toolkit's parts:
// each answer is small, and nothing stays on the Newton between them. The
// desktop sends 'NCss' with a request frame; the answer is 'NCsr' with:
//
//   {op: 'screen}                 -> {left, top, right, bottom} of the
//                                    screen, and the depth and rowBytes of
//                                    a shot of its first row
//   {op: 'rows, left, top, right, bottom}
//                                 -> {top, bottom, rowBytes, depth, theBits}:
//                                    a shot of those rows; blank: true
//                                    instead of theBits if they are white
//   {op: 'take}                   -> the whole screen in one piece, as
//                                    'snap' (to compare): {top, left, bottom,
//                                    right, rowBytes, depth, theBits}
//
// or {error: -28010} without the Toolkit app (newtoolspro), whose
// ScreenShotFn takes the shots. An exception becomes {error, name} instead
// of ending the session. Hiding the Dock slip while the user arranges the
// screen is still the Cocoa NCX's 'scrn'.

func(ep)
begin
  local request := ep:ReadCommandData();
  local answer;
  try
  begin
    local op := if IsFrame(request) then request.op;
    local ntp := GetRoot().newtoolspro;
    if not ntp then
      answer := {error: -28010}
    else if op = 'screen then
    begin
      local box := GetRoot():LocalBox();
      local shot := {left: box.left, top: box.top, right: box.right, bottom: box.top + 1};
      ntp._proto:ScreenShotFn(shot);
      answer := {left: box.left, top: box.top, right: box.right, bottom: box.bottom,
                 depth: shot.depth, rowBytes: shot.rowBytes};
    end
    else if op = 'rows then
    begin
      local shot := {left: request.left, top: request.top, right: request.right, bottom: request.bottom};
      ntp._proto:ScreenShotFn(shot);
      answer := {top: shot.top, bottom: shot.bottom, rowBytes: shot.rowBytes, depth: shot.depth};
      // white rows (all 0) aren't sent: a native compare, much less than
      // sending them (a fresh binary is all 0; if not, the bits go)
      if BinEqual(shot.theBits, MakeBinary(Length(shot.theBits), 'bits)) then
        answer.blank := true
      else
        answer.theBits := shot.theBits;
    end
    else if op = 'take then
    begin
      local shot := {};
      ntp._proto:ScreenShotFn(shot);
      answer := {top: shot.top, left: shot.left, bottom: shot.bottom, right: shot.right,
                 rowBytes: shot.rowBytes, depth: shot.depth, theBits: shot.theBits};
    end
    else
      answer := {error: -1, name: "unknown request"};
  end
  onexception |evt.ex| do
  begin
    local ex := CurrentException();
    answer := {error: if IsFrame(ex.data) and IsInteger(ex.data.errorCode) then ex.data.errorCode
                      else if IsInteger(ex.error) then ex.error else -1,
               name: SPrintObject(ex.name)};
  end;
  ep:WriteCommand("NCsr", answer, true);
  nil;
end;
